# No dot-directories except github/vscode
.*/
!.vscode/
!.github/
.commitinfo

*.code-workspace
node_modules
nbproject

# Build output — the CI builds it; the adapter is installed from npm, never from GitHub
build/

# npm package files
iobroker.*.tgz

Thumbs.db

# i18n intermediate files
admin/i18n/flat.txt
admin/i18n/*/flat.txt
.DS_Store


# Admin custom component (Module Federation): the BUILT admin/custom/ IS git-tracked —
# the Module-Federation bundle is what the Admin loads and no install step rebuilds it.
# Only the src-admin work dirs are ignored.
/src-admin/build
/src-admin/.__mf__temp
/src-admin/node_modules
/src-admin/package-lock.json

# Coverage report (npm run coverage) — generated, never committed
coverage

# Value dumps of the inventory run (readable-values judge) — generated on every run, never committed
test/states.inventory.json
test/objects.inventory.de.json
