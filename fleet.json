{
  "_comment": "Adapter-specific declarations for the fleet tooling (Entwicklung/scripts). They live HERE so that a change in this adapter never touches the locked tooling. Readers: sync-iopackage-from-i18n.py (manifestI18n, release gate B03) and submit-stable.py (forumThread). Keys starting with an underscore are comments.",
  "manifestI18n": {
    "_comment": "instanceObjects id -> key in admin/i18n/<lang>.json. Every manifest object needs a `name` entry (an object without one is a structural error, and so is an entry whose object no longer exists); `desc` only where the name does not already say it - an empty desc beats an invented sentence.",
    "_note": "Names: the instance objects of the manifest. Descriptions: since v1.15.0 EVERY datapoint carries an understandable explanation.",
    "name": {
      "auth": "authChannel",
      "auth.session": "session",
      "auth.verificationUrl": "verificationUrl",
      "auth.signedIn": "signedIn",
      "auth.lastError": "lastError",
      "info": "channelInfo",
      "info.connection": "connection",
      "info.devicesTotal": "devicesTotal",
      "info.devicesOnline": "devicesOnline",
      "info.devicesAllOnline": "devicesAllOnline"
    },
    "desc": {
      "auth.session": "sessionDesc",
      "auth.signedIn": "signedInDesc",
      "auth.lastError": "lastErrorDesc",
      "auth.verificationUrl": "verificationUrlDesc",
      "info.connection": "connectionDesc",
      "info.devicesTotal": "devicesTotalDesc",
      "info.devicesOnline": "devicesOnlineDesc",
      "info.devicesAllOnline": "devicesAllOnlineDesc"
    }
  },
  "forumThread": "https://forum.iobroker.net/topic/85641/test-adapter-homeconnect-2.0.0-alpha",
  "_deviceIds": "Device object ids follow the fleet scheme model + the last four characters of the unit id (decision 36), set once and never derived again; a taken id gets the whole unit id, then a counter.",
  "deviceIds": "unit",
  "serverTest": {
    "_why": "Sign-in, event stream and the appliances come up on the real account, and a switched setting is confirmed only by the appliance's NOTIFY on the stream (decision 8).",
    "observeSeconds": 120,
    "connectSeconds": 180,
    "startSpacingSeconds": 60,
    "reads": [
      {
        "id": "info.connection",
        "expect": "true"
      },
      {
        "id": "*.info.reachable",
        "expect": "true"
      },
      {
        "id": "*.status.operationState",
        "expect": "nonEmpty"
      }
    ],
    "commands": [
      {
        "id": "*.settings.lightExternalPower",
        "online": "*.info.reachable",
        "value": "toggle",
        "timeoutSeconds": 60
      }
    ]
  },
  "suites": {
    "connectionTest": {
      "command": "checkConnection",
      "message": {}
    },
    "groupSwitches": {
      "none": "The instance settings have no switch that turns a group of datapoints on or off."
    },
    "rename": true,
    "rejectLogin": true,
    "dropDevice": true
  },
  "fixtureLimits": [
    {
      "state": "hcfixairconditioner-0001.options.setpointTemperature",
      "file": "test/fixtures/inventory/AirConditioner.json",
      "min": "/programOptions/2/constraints/min",
      "max": "/programOptions/2/constraints/max",
      "step": "/programOptions/2/constraints/stepsize"
    },
    {
      "state": "hcfixairconditioner-0001.options.fanSpeedPercentage",
      "file": "test/fixtures/inventory/AirConditioner.json",
      "min": "/programOptions/1/constraints/min",
      "max": "/programOptions/1/constraints/max",
      "step": "/programOptions/1/constraints/stepsize"
    },
    {
      "state": "hcfixfridgefreezer-0001.settings.setpointTemperatureFreezer",
      "file": "test/fixtures/inventory/FridgeFreezer.json",
      "min": "/settings/32/constraints/min",
      "max": "/settings/32/constraints/max",
      "step": "/settings/32/constraints/stepsize"
    },
    {
      "state": "hcfixfridgefreezer-0001.settings.setpointTemperatureRefrigerator",
      "file": "test/fixtures/inventory/FridgeFreezer.json",
      "min": "/settings/33/constraints/min",
      "max": "/settings/33/constraints/max",
      "step": "/settings/33/constraints/stepsize"
    },
    {
      "state": "hcfixhood-0001.settings.colorTemperaturePercent",
      "file": "test/fixtures/inventory/Hood.json",
      "min": "/settings/11/constraints/min",
      "max": "/settings/11/constraints/max",
      "step": "/settings/11/constraints/stepsize"
    },
    {
      "state": "hcfixoven-0001.options.setpointTemperature",
      "file": "test/fixtures/inventory/Oven.json",
      "min": "/programOptions/13/constraints/min",
      "max": "/programOptions/13/constraints/max",
      "step": "/programOptions/13/constraints/stepsize"
    },
    {
      "state": "hcfixwasher-0001.settings.iDos1BaseLevel",
      "file": "test/fixtures/inventory/Washer.json",
      "min": "/settings/8/constraints/min",
