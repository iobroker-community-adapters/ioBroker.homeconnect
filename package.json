{
  "name": "iobroker.homeconnect",
  "version": "1.23.0",
  "description": "Home Connect / BSH home appliances (Bosch, Siemens, NEFF, Gaggenau) via the Home Connect cloud API, with clean typed data points",
  "author": {
    "name": "krobi",
    "email": "krobi@power-dreams.com"
  },
  "contributors": [
    {
      "name": "TA2k",
      "email": "tombox2020@gmail.com",
      "role": "Original author"
    },
    {
      "name": "Lucky-ESA",
      "role": "Maintenance 2025-2026"
    },
    {
      "name": "iobroker-community-adapters",
      "email": "iobroker-community-adapters@gmx.de",
      "role": "Maintenance 2023-2026"
    },
    {
      "name": "Claude (Anthropic)",
      "role": "Coding assistance"
    }
  ],
  "homepage": "https://github.com/krobipd/ioBroker.homeconnect",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "homeconnect",
    "BSH",
    "bosch",
    "siemens",
    "neff",
    "gaggenau",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krobipd/ioBroker.homeconnect"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/iobroker": "npm:@iobroker/types@^7.2.3",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.2",
    "iobroker-adapter-checks": "^0.19.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "build:admin": "node tasks",
    "publish:manual": "node tasks && npm publish",
    "watch": "build-adapter ts --watch",
    "check": "tsc --noEmit",
    "check:admin": "node src-admin/node_modules/typescript/bin/tsc --noEmit -p src-admin/tsconfig.json",
    "test:admin": "npm run check:admin && npm --prefix src-admin run test",
    "test:ts": "vitest run",
    "test:unit": "vitest run",
    "test:package": "mocha test/package --exit",
    "test:inventory": "mocha test/inventory.js --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "coverage": "vitest run --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write . \"!build/**\" \"!admin/custom/**\" \"!src-admin/.__mf__temp/**\" \"!src-admin/package.json\" \"!src-admin/package-lock.json\" \"!.github/dependabot.yml\" \"!.github/FUNDING.yml\" \"!.github/workflows/automerge-dependabot.yml\" \"!.github/copilot-instructions.md\" \"!.vscode/**\" \"!io-package.json\" \"!README.md\" \"!CHANGELOG_OLD.md\" \"!package-lock.json\" \"!.releaseconfig.json\" \"!tsconfig.json\" \"!tsconfig.build.json\" \"!test/objects.inventory.json\"",
    "format:check": "prettier --check . \"!build/**\" \"!admin/custom/**\" \"!src-admin/.__mf__temp/**\" \"!src-admin/package.json\" \"!src-admin/package-lock.json\" \"!.github/dependabot.yml\" \"!.github/FUNDING.yml\" \"!.github/workflows/automerge-dependabot.yml\" \"!.github/copilot-instructions.md\" \"!.vscode/**\" \"!io-package.json\" \"!README.md\" \"!CHANGELOG_OLD.md\" \"!package-lock.json\" \"!.releaseconfig.json\" \"!tsconfig.json\" \"!tsconfig.build.json\" \"!test/objects.inventory.json\"",
    "fix:changelog": "node -e \"const fs=require('fs');for(const[f,r]of[['README.md',/^(-->[ \\t]*)\\r?\\n(#{1,6} )/m],['CHANGELOG_OLD.md',/^(#{1,6} .*)\\r?\\n(#{1,6} )/]])if(fs.existsSync(f)){const t=fs.readFileSync(f,'utf8'),n=t.replace(r,(m,a,b)=>a+'\\n\\n'+b);if(n!==t)fs.writeFileSync(f,n)}\"",
    "release": "release-script",
    "release-patch": "release-script patch --yes --all",
    "release-minor": "release-script minor --yes --all",
    "release-major": "release-script major --yes --all",
    "translate": "translate-adapter"
  },
  "bugs": {
    "url": "https://github.com/krobipd/ioBroker.homeconnect/issues"
  },
  "readmeFilename": "README.md",
  "overrides": {
    "esbuild": ">=0.25.0"
  }
}
